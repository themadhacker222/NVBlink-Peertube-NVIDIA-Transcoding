{
    "name": "peertube-plugin-nvblink-hardware-transcode-nvenc",
    "version": "1.0.1",
    "license": "MIT",
    "description": "Plugin that adds transcode profiles, multi-gpu parallel job runs, and settings which use NVIDIA NVDEC/NVENC for hardware acceleration",
    "engine": {
        "peertube": ">=5.1.0"
    },
    "keywords": [
        "peertube",
        "plugin"
    ],
    "homepage": "https://github.com/themadhacker222/NVBlink-Peertube-NVIDIA-Transcoding",
    "author": "themadhacker",
    "bugs": "https://github.com/themadhacker222/NVBlink-Peertube-NVIDIA-Transcoding/issues",
    "library": "./dist/main.js",
    "files": [
        "/dist"
    ],
    "staticDirs": {},
    "css": [],
    "clientScripts": [],
    "translations": {},
    "scripts": {
        "clean": "rm -rf dist/*",
        "prepare": "npm run build",
        "build": "npx tsc --build src/tsconfig.json",
        "watch": "npx tsc --build src/tsconfig.json --watch"
    },
    "devDependencies": {
        "@peertube/peertube-types": "^5.1.0",
        "@tsconfig/node16": "^1.0.3",
        "typescript": "^5.1.6"
    }
}
